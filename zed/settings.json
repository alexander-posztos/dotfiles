// Zed settings. Mirrors the nvim (kickstart) setup: tokyonight, JetBrainsMono Nerd Font
// without ligatures, relative numbers, 2-space tabs, 1s autosave, format on save.
// Docs: https://zed.dev/docs/configuring-zed
{
  "diff_view_style": "unified",
  "cli_default_open_behavior": "existing_window",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "relative_line_numbers": true,
  "cursor_blink": false,
  "vertical_scroll_margin": 10,
  "tab_size": 2,
  "hard_tabs": false,
  "show_whitespaces": "trailing",
  "soft_wrap": "none",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "format_on_save": "on",
  "icon_theme": "Zed (Default)",
  "ui_font_size": 16,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 14,
  "buffer_font_features": {
    "calt": false
  },
  "auto_install_extensions": {
    "tokyo-night": true,
    "latex": true
  },
  "theme": {
    "mode": "dark",
    "light": "Tokyo Night Light",
    "dark": "Tokyo Night"
  },
  "scrollbar": {
    "show": "always",
    "git_diff": true,
    "diagnostics": "error",
    "axes": {
      "horizontal": false
    }
  },
  "toolbar": {
    "breadcrumbs": true
  },
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": false
    }
  },
  "project_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "right",
    "tree_view": true,
    "file_icons": true,
    "starts_open": true,
    "entry_primary_click_action": "file_diff"
  },
  "edit_predictions": {
    "mode": "subtle"
  },
  "show_edit_predictions": false,
  // LaTeX: texlab builds with tectonic on save into build/ and pokes Skim (SyncTeX forward search).
  // -Z continue-on-errors works around the pdfx (PDF/A) CreationDate error in the vutinfth template.
  "lsp": {
    "texlab": {
      "settings": {
        "texlab": {
          "build": {
            "executable": "tectonic",
            "args": ["-X", "compile", "%f", "--synctex", "--keep-logs", "--keep-intermediates",
                     "-Z", "continue-on-errors", "--outdir", "build"],
            "auxDirectory": "build",
            "pdfDirectory": "build",
            "onSave": true,
            "forwardSearchAfter": true
          },
          "forwardSearch": {
            "executable": "/Applications/Skim.app/Contents/SharedSupport/displayline",
            "args": ["-r", "%l", "%p", "%f"]
          }
        }
      }
    }
  },
  "languages": {
    "Python": {
      "tab_size": 4
    },
    "Markdown": {
      "soft_wrap": "editor_width"
    }
  }
}
